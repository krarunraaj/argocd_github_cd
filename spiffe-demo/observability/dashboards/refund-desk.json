{
 "uid": "refund-desk",
 "title": "Refund desk: end to end",
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "tags": [
  "refund-desk"
 ],
 "panels": [
  {
   "id": 1,
   "title": "Requests per second, by service",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service_name) (rate(traces_span_metrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[2m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "{{service_name}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "title": "p95 latency, by service",
   "type": "timeseries",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(traces_span_metrics_duration_milliseconds_bucket{span_kind=\"SPAN_KIND_SERVER\"}[5m])))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "{{service_name}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "title": "Failed requests, by service",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service_name) (rate(traces_span_metrics_calls_total{span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\"}[5m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "{{service_name}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "title": "Router outcomes (answered, blocked, no route)",
   "type": "timeseries",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status, code) (increase(router_requests_total[5m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "{{status}} {{code}}"
    }
   ]
  },
  {
   "id": 5,
   "title": "Time the refund agent takes (router view)",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(router_handoff_seconds_bucket[5m])))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "p95"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(router_handoff_seconds_bucket[5m])))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "p50"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "title": "Gateway: requests by status (403 = identity refused)",
   "type": "timeseries",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(agentgateway_requests_total{gateway=\"refund-desk/refund-gateway\"}[2m]))",
     "legendFormat": "HTTP {{status}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "title": "Logs: errors and warnings, all refund-desk pods",
   "type": "logs",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 24,
    "h": 9
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{namespace=\"refund-desk\"} |~ \"(?i)error|warn|exception|denied|authorization failed\"",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ]
  },
  {
   "id": 8,
   "title": "Logs: refund-desk, all pods",
   "type": "logs",
   "gridPos": {
    "x": 0,
    "y": 33,
    "w": 24,
    "h": 10
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{namespace=\"refund-desk\"}",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ]
  }
 ],
 "links": [
  {
   "title": "Langfuse traces",
   "type": "link",
   "url": "http://localhost:3002",
   "targetBlank": true
  }
 ]
}